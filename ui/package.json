{
  "name": "@comfyorg/comfyui-frontend",
  "version": "1.55.14",
  "private": true,
  "description": "Official front-end implementation of ComfyUI",
  "homepage": "https://comfy.org",
  "license": "GPL-3.0-only",
  "repository": "https://github.com/Comfy-Org/ComfyUI_frontend",
  "type": "module",
  "scripts": {
    "adr:check": "tsx scripts/check-adrs.ts",
    "build:desktop-dist": "cross-env DISTRIBUTION=desktop vite build --config vite.config.mts",
    "build-storybook": "storybook build",
    "build:types": "vite build --config vite.types.config.mts && tsx scripts/prepare-types.ts",
    "build:analyze": "cross-env ANALYZE_BUNDLE=true pnpm build",
    "build": "pnpm typecheck && vite build --config vite.config.mts",
    "clean": "pnpm dlx rimraf dist dist-ssr coverage node_modules/.vite",
    "clean:all": "pnpm clean && pnpm dlx rimraf node_modules",
    "size:collect": "tsx scripts/size-collect.ts",
    "size:report": "tsx scripts/size-report.ts",
    "dev:cloud": "pnpm dev:cloud:test",
    "dev:cloud:test": "cross-env DEV_SERVER_COMFYUI_URL=https://testcloud.comfy.org/ vite --config vite.config.mts",
    "dev:cloud:staging": "cross-env DEV_SERVER_COMFYUI_URL=https://stagingcloud.comfy.org/ vite --config vite.config.mts",
    "dev:cloud:prod": "cross-env DEV_SERVER_COMFYUI_URL=https://cloud.comfy.org/ vite --config vite.config.mts",
    "dev:cloud:crdt": "cross-env DEV_SERVER_COMFYUI_URL=https://testcloud.comfy.org/ VITE_AGENT_CRDT_FOLLOWER=true vite --config vite.config.mts --port 6273 --strictPort",
    "dev:desktop": "pnpm --filter @comfyorg/desktop-ui run dev",
    "dev:electron": "cross-env DISTRIBUTION=desktop vite --config vite.electron.config.mts",
    "dev:no-vue": "cross-env DISABLE_VUE_PLUGINS=true vite --config vite.config.mts",
    "dev:test": "cross-env VITE_USE_LEGACY_DEFAULT_GRAPH=true vite --config vite.config.mts",
    "dev": "vite --config vite.config.mts",
    "fallow": "fallow",
    "fallow:audit": "fallow audit",
    "format:check": "oxfmt --check",
    "format": "oxfmt --write",
    "json-schema": "tsx scripts/generate-json-schema.ts",
    "knip:no-cache": "knip",
    "knip": "knip --cache",
    "lint:fix:no-cache": "pnpm oxlint:main --fix && pnpm oxlint:audit && eslint --concurrency auto --fix",
    "lint:fix": "pnpm oxlint:main --fix && pnpm oxlint:audit && eslint --cache --cache-strategy content --concurrency auto --fix",
    "lint:no-cache": "pnpm exec stylelint '{apps,packages,src}/**/*.{css,vue}' && pnpm oxlint && eslint --concurrency auto",
    "lint:unstaged:fix": "tsx scripts/lint-unstaged.ts --fix",
    "lint:unstaged": "tsx scripts/lint-unstaged.ts",
    "lint": "pnpm stylelint && pnpm oxlint && eslint --cache --cache-strategy content --concurrency auto",
    "locale": "tsx scripts/i18n/update-locales.ts",
    "locale:check": "tsx scripts/i18n/update-locales.ts --check",
    "oxlint:audit": "oxlint --config tools/oxlint-plugins/vitestCleanup.config.json .",
    "oxlint:main": "oxlint src scripts tools/oxlint-plugins packages/account-core/src packages/account-ui/src packages/billing-contract/src --type-aware",
    "oxlint": "pnpm oxlint:main && pnpm oxlint:audit",
    "preview": "vite preview --config vite.config.mts",
    "storybook": "storybook dev -p 6006",
    "stylelint:fix": "stylelint --cache --cache-strategy content --fix '{apps,packages,src}/**/*.{css,vue}'",
    "stylelint": "stylelint --cache --cache-strategy content '{apps,packages,src}/**/*.{css,vue}'",
    "test:coverage": "vitest run --coverage",
    "test:unit": "vitest run",
    "typecheck": "pnpm typecheck:app && pnpm typecheck:account-core && pnpm typecheck:account-ui && pnpm typecheck:billing-contract",
    "typecheck:app": "vue-tsc --noEmit",
    "typecheck:account-core": "pnpm --filter @comfyorg/account-core typecheck",
    "typecheck:account-ui": "pnpm --filter @comfyorg/account-ui typecheck",
    "typecheck:billing-contract": "pnpm --filter @comfyorg/billing-contract typecheck",
    "typecheck:build": "vue-tsc --project build/tsconfig.json",
    "typecheck:scripts": "vue-tsc --project scripts/tsconfig.json",
    "typecheck:tools": "vue-tsc --project tools/tsconfig.json",
    "zipdist": "tsx scripts/zipdist.ts"
  },
